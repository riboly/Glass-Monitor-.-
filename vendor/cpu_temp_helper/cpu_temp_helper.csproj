<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>false</PublishSingleFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\bin\cpu_temp\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LibreHardwareMonitorLib">
      <HintPath>..\lhm\LibreHardwareMonitorLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="HidSharp">
      <HintPath>..\lhm\HidSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="RAMSPDToolkit-NDD">
      <HintPath>..\lhm\RAMSPDToolkit-NDD.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
